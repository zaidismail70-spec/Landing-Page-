rules_version = '2';

// Default-deny. Every write in this app happens through the submitOrder
// Cloud Function using the Admin SDK, which bypasses these rules entirely.
// No browser client — authenticated or not — may read or write any
// collection here, so customer and order data is never directly exposed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
