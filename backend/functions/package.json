{
  "name": "plasma-landing-functions",
  "description": "Cloud Functions for the Betolla PLASMA landing page order pipeline",
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "test:unit": "node --test test/unit/*.test.js",
